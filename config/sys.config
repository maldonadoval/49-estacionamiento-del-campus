[
  {p49_estacionamiento_del_campus, [
    {http_port, 8080},
    {http_enabled, true},
    %% PIN de demostracion solicitado por el equipo. En produccion se puede
    %% sobreescribir con la variable de entorno P49_ADMIN_PIN.
    {admin_pin, <<"050618">>},
    {reserva_ttl_seg, 600},
    %% El campus arranca vacio: la ocupacion real solo aparece cuando los
    %% alumnos reservan y registran su entrada. Se puede activar la siembra
    %% determinista para demos con seed_ocupacion = true.
    {seed_ocupacion, false}
  ]},
  {kernel, [
    {logger_level, info},
    {logger, [
      {handler, default, logger_std_h,
       #{config => #{type => standard_io},
         formatter => {logger_formatter,
                       #{template => [time, " ", level, " ", msg, "\n"]}}}}
    ]}
  ]}
].
